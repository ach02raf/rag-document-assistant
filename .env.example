# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Modèles (optionnel) ---
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Base de données (utilisée en mode local ; docker-compose la surcharge) ---
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- RAG (optionnel) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=20
FINAL_K=5
RERANK_ENABLED=true
CORS_ORIGINS=http://localhost:3000
